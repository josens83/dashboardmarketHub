# Dashboard Market Hub - 환경 변수 설정
# 이 파일을 복사하여 .env 파일을 생성하고 실제 값을 입력하세요

# ===================
# Supabase 설정 (필수!)
# ===================
# Supabase 프로젝트 URL (https://app.supabase.com/project/_/settings/api)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (공개 키)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===================
# API 설정 (선택사항 - 추가 백엔드가 있는 경우)
# ===================
# 백엔드 API 기본 URL
VITE_API_BASE_URL=https://api.yourdomain.com

# WebSocket 서버 URL (Supabase Realtime으로 대체 가능)
VITE_WS_URL=wss://ws.yourdomain.com

# ===================
# 에러 추적 - Sentry
# ===================
# Sentry DSN (프론트엔드용)
VITE_SENTRY_DSN=https://your-public-key@sentry.io/your-project-id

# Sentry Environment (production, staging, development)
VITE_SENTRY_ENVIRONMENT=production

# Sentry Source Maps Upload (빌드 시 사용)
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your-organization-slug
SENTRY_PROJECT=your-project-slug

# ===================
# 인증 설정
# ===================
# JWT Secret Key (백엔드에서 사용)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Token 만료 시간 (초)
JWT_EXPIRATION=86400

# ===================
# 결제 게이트웨이 - Stripe
# ===================
# Stripe Publishable Key (프론트엔드용 공개 키)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Secret Key (백엔드/Edge Function용 비밀 키)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe Webhook Secret (웹훅 서명 검증용)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs - Basic 플랜
VITE_STRIPE_PRICE_BASIC_MONTHLY=price_basic_monthly_id
VITE_STRIPE_PRICE_BASIC_YEARLY=price_basic_yearly_id

# Stripe Price IDs - Professional 플랜
VITE_STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_id
VITE_STRIPE_PRICE_PRO_YEARLY=price_pro_yearly_id

# Stripe Price IDs - Enterprise 플랜
VITE_STRIPE_PRICE_ENT_MONTHLY=price_ent_monthly_id
VITE_STRIPE_PRICE_ENT_YEARLY=price_ent_yearly_id

# ===================
# 결제 게이트웨이 - Toss Payments (선택사항)
# ===================
# Toss Payments API Key (선택사항)
TOSS_CLIENT_KEY=test_ck_your_toss_client_key
TOSS_SECRET_KEY=test_sk_your_toss_secret_key

# ===================
# 데이터베이스 (백엔드)
# ===================
# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/dashboard_market_hub

# Redis (세션, 캐시)
REDIS_URL=redis://localhost:6379

# ===================
# 이메일 서비스 - Resend
# ===================
# Resend API Key (서버사이드/Edge Function용)
RESEND_API_KEY=re_your_resend_api_key

# 발신자 이메일 주소 (Resend에서 인증된 도메인)
RESEND_FROM_EMAIL=Dashboard Market Hub <noreply@yourdomain.com>

# ===================
# 이메일 서비스 - SMTP (백업/선택사항)
# ===================
# SMTP 설정
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# ===================
# 스토리지
# ===================
# AWS S3 (파일 업로드)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=dashboard-market-hub
AWS_REGION=ap-northeast-2

# ===================
# 외부 서비스
# ===================
# Google Analytics
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# 구글 로그인 (OAuth)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===================
# 앱 설정
# ===================
# 프로덕션 모드 (production / development)
NODE_ENV=production

# 앱 기본 URL
VITE_APP_URL=https://yourdomain.com

# CORS 허용 도메인
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# ===================
# 보안
# ===================
# CORS 설정
ENABLE_CORS=true

# Rate Limiting (요청 제한)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===================
# 로깅
# ===================
# 로그 레벨 (debug, info, warn, error)
LOG_LEVEL=info

# ===================
# 개발 환경 전용
# ===================
# Hot Module Replacement
VITE_HMR=true

# Debug 모드
DEBUG=true
