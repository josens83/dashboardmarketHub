# Dashboard Market Hub - 환경 변수 설정
# 이 파일을 복사하여 .env 파일을 생성하고 실제 값을 입력하세요

# ===================
# Supabase 설정 (필수!)
# ===================
# Supabase 프로젝트 URL (https://app.supabase.com/project/_/settings/api)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (공개 키)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===================
# API 설정 (선택사항 - 추가 백엔드가 있는 경우)
# ===================
# 백엔드 API 기본 URL
VITE_API_BASE_URL=https://api.yourdomain.com

# WebSocket 서버 URL (Supabase Realtime으로 대체 가능)
VITE_WS_URL=wss://ws.yourdomain.com

# ===================
# 에러 추적
# ===================
# Sentry DSN (또는 다른 에러 추적 서비스)
VITE_ERROR_TRACKING_ENDPOINT=https://your-sentry-dsn@sentry.io/project-id

# ===================
# 인증 설정
# ===================
# JWT Secret Key (백엔드에서 사용)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Token 만료 시간 (초)
JWT_EXPIRATION=86400

# ===================
# 결제 게이트웨이
# ===================
# Stripe API Key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Toss Payments API Key (선택사항)
TOSS_CLIENT_KEY=test_ck_your_toss_client_key
TOSS_SECRET_KEY=test_sk_your_toss_secret_key

# ===================
# 데이터베이스 (백엔드)
# ===================
# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/dashboard_market_hub

# Redis (세션, 캐시)
REDIS_URL=redis://localhost:6379

# ===================
# 이메일 서비스
# ===================
# SMTP 설정
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# SendGrid (선택사항)
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# ===================
# 스토리지
# ===================
# AWS S3 (파일 업로드)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=dashboard-market-hub
AWS_REGION=ap-northeast-2

# ===================
# 외부 서비스
# ===================
# Google Analytics
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# 구글 로그인 (OAuth)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===================
# 앱 설정
# ===================
# 프로덕션 모드 (production / development)
NODE_ENV=production

# 앱 기본 URL
VITE_APP_URL=https://yourdomain.com

# CORS 허용 도메인
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# ===================
# 보안
# ===================
# CORS 설정
ENABLE_CORS=true

# Rate Limiting (요청 제한)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===================
# 로깅
# ===================
# 로그 레벨 (debug, info, warn, error)
LOG_LEVEL=info

# ===================
# 개발 환경 전용
# ===================
# Hot Module Replacement
VITE_HMR=true

# Debug 모드
DEBUG=true
